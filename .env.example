# Optional: Google Gemini API key for AI forensic summaries.
# Without it the demo falls back to deterministic template responses.
GEMINI_API_KEY=

# Required for persistent KMS / signing across restarts.
# Generate with: openssl rand -hex 32
# Minimum 16 characters. Never commit a real value.
KMS_MASTER_KEY=

# Set to 1 to allow an ephemeral in-memory master key when KMS_MASTER_KEY is unset
# (useful for pure local concept demos). Data will not survive process restarts.
DEMO_MODE=1

# Server port
PORT=3000

# Public URL of the app (used for self-links / QR targets in demos)
APP_URL=http://localhost:3000
